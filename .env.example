APP_ENV=development
HTTP_ADDR=:8081
PUBLIC_BASE_URL=https://federation.testagram.site
INSTANCE_DOMAIN=testagram.site
SERVICE_ACTOR_USERNAME=testagram
SERVICE_ACTOR_NAME=Testagram
SERVICE_ACTOR_SUMMARY=The Testagram federated social network
PUBLIC_KEY_PEM=
FEDERATION_DATABASE_URL=postgres://testagram_federation:replace-me@federation-db:5432/testagram_federation?sslmode=disable
BACKEND_INTERNAL_URL=http://api:8081
# Federation -> Backend actor/readiness credential (maps to Backend FEDERATION_BACKEND_INTERNAL_TOKEN).
BACKEND_INTERNAL_TOKEN=REPLACE_WITH_FEDERATION_BACKEND_INTERNAL_TOKEN
# Backend -> Federation activity-ingress credential (maps to Backend FEDERATION_INTERNAL_TOKEN).
FEDERATION_INGRESS_TOKEN=REPLACE_WITH_FEDERATION_INGRESS_TOKEN
