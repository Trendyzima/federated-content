# Production template only. Create a dedicated Neon database named federation
# and a least-privilege role for this service. Use the Neon pooled endpoint.
# Never commit a real connection string or put this value in frontend config.
APP_ENV=production
FEDERATION_DATABASE_URL=postgresql://FEDERATION_ROLE:REPLACE_ME@YOUR_NEON_POOLER_HOST/federation?sslmode=require&connect_timeout=5
